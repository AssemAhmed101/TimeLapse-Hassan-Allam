# Copy this file to .env.production before deployment.

ENVIRONMENT=production

# CHANGE THIS before production.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Public HTTP port for the dashboard/reverse proxy.
HTTP_PORT=80

# Comma-separated browser origins allowed by the API.
# Example when using a real domain:
# CORS_ORIGINS=https://timelapse.example.com
CORS_ORIGINS=http://localhost

# Comma-separated trusted Host headers.
# Example:
# TRUSTED_HOSTS=timelapse.example.com,www.timelapse.example.com
TRUSTED_HOSTS=*

SNAPSHOT_RETENTION_DAYS=30
TIMELAPSE_RETENTION_DAYS=365
STORAGE_WARNING_FREE_GB=5

# Development/local cloud simulation.
CLOUD_PROVIDER=local_mock
CLOUD_BUCKET=timelapse-system
CLOUD_PREFIX=project
CLOUD_RETRY_COUNT=3
CLOUD_RETRY_DELAY_SECONDS=2

# Required only for S3 / Cloudflare R2 / compatible storage.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_ENDPOINT_URL=

LOG_LEVEL=INFO
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5
