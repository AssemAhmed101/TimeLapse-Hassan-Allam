PROJECT_NAME=Tower Time-Lapse System
VERSION=1.2.0
ENVIRONMENT=development

SNAPSHOT_RETENTION_DAYS=0
TIMELAPSE_RETENTION_DAYS=365
STORAGE_WARNING_FREE_GB=5
STORAGE_CAPACITY_GB=8192
STORAGE_WARNING_LEVELS=70,85,95
EXPECTED_CAMERA_COUNT=2
CAPTURES_PER_CAMERA_PER_DAY=4
ASSUMED_IMAGE_SIZE_MB=20
MIN_SNAPSHOT_BYTES=1024

CLOUD_PROVIDER=local_mock
CLOUD_BUCKET=timelapse-system
CLOUD_PREFIX=project
CLOUD_RETRY_COUNT=3
CLOUD_RETRY_DELAY_SECONDS=2

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_ENDPOINT_URL=

JWT_SECRET_KEY=CHANGE-ME-IN-PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

LOG_LEVEL=INFO
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5

CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
TRUSTED_HOSTS=*
